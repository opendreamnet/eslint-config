{
  "name": "@opendreamnet/eslint-config",
  "description": "ESLint config for OpenDreamnet projects.",
  "version": "0.3.2",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "release": "release-it",
    "deploy": "git push --follow-tags origin main",
    "upgrade": "pnpm dlx npm-check-updates -i",
    "build": "tsc",
    "watch": "tsc -w",
    "inspect": "pnpm dlx @eslint/config-inspector@latest --open false",
    "test": "eslint tests --config eslint.config.js"
  },
  "author": {
    "name": "Ivan Bravo Bravo",
    "email": "ivan@opendreamnet.com"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "dependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@types/eslint__js": "^8.42.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "typescript-eslint": "^8.48.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^9.0.4",
    "@tsconfig/node-lts": "^20.1.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/eslint": "9.6.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "release-it": "^17.11.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unbuild": "^2.0.0"
  },
  "peerDependencies": {
    "eslint": "^9",
    "typescript": "^5"
  }
}
