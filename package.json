{
  "name": "@opendreamnet/eslint-config",
  "description": "ESLint config for OpenDreamnet projects.",
  "version": "0.3.2",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "release-it": {
    "extends": "github:opendreamnet/release-it-config"
  },
  "prettier": "@opendreamnet/prettier-config",
  "scripts": {
    "release": "release-it",
    "upgrade": "pnpm dlx npm-check-updates -i",
    "build": "rm -rf dist && tsc",
    "watch": "tsc -w",
    "inspect": "pnpm dlx @eslint/config-inspector@latest --open false",
    "lint": "tsc && eslint src --config eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && eslint tests --config eslint.config.js"
  },
  "author": {
    "name": "Ivan Bravo Bravo",
    "email": "ivan@opendreamnet.com"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/utils": "^8.71.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@opendreamnet/prettier-config": "^0.2.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/eslint-plugin-promise": "^7.3.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
